{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "env": {
    "NODE_ENV": "production"
  },
  "public": "client/dist",
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 60,
      "includeFiles": ["client/dist/**", "server/dist/**"]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(playground|keys|analytics|settings|dashboard|auth)/?$",
      "destination": "/index.html"
    },
    {
      "source": "/(?!assets|favicon|icons|index\\.html|[^/]*\\.).*",
      "destination": "/index.html"
    }
  ]
}
