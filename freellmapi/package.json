{
  "name": "freellmapi",
  "private": true,
  "workspaces": [
    "shared",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server \"npm run dev -w server\"",
    "test": "npm run test -w server",
    "build": "tsc -p tsconfig.api.json",
    "build:server": "npm run build -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  }
}
