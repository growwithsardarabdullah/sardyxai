# ============================================================================
# FreeLLMAPI Production Environment Configuration
# ============================================================================
# WARNING: This file contains sensitive credentials. Never commit to git.
# Use Vercel environment variables or secure secret management instead.

NODE_ENV=production
PORT=3001

# ============================================================================
# CORS Configuration
# ============================================================================
# Set your production frontend domain(s)
DASHBOARD_ORIGINS=https://your-domain.com,https://app.your-domain.com

# ============================================================================
# Rate Limiting
# ============================================================================
# Requests per minute for /v1 proxy endpoint (0 = disabled)
PROXY_RATE_LIMIT_RPM=60

# ============================================================================
# Encryption & Security
# ============================================================================
# ⚠️ REQUIRED: 32-character hex encryption key for sensitive data
# Generate: openssl rand -hex 16
ENCRYPTION_KEY=your-32-character-hex-key-here-replace-me

# ⚠️ REQUIRED: Strong session secret for secure cookies
# Generate: openssl rand -base64 32
SESSION_SECRET=your-strong-random-session-secret-here-replace-me

# ============================================================================
# Supabase Configuration (Production)
# ============================================================================
# Your Supabase project URL
# Get from: https://app.supabase.com/project/_/settings/general
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (public, safe in browser)
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase service role key (private, for server-only operations)
# Get from: https://app.supabase.com/project/_/settings/api
# ⚠️ KEEP THIS SECRET - Never commit or expose in browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ============================================================================
# Encryption Configuration
# ============================================================================

# AES-256-GCM encryption key for API key storage
# Generate new key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be 64 hexadecimal characters (32 bytes)
ENCRYPTION_KEY=eb04dc25787c053d6a54d6f351cadb5970c53b1eb6e7ef0d921a07a000643400

# Session secret for HMAC-signed auth tokens
SESSION_SECRET=d0104673f25d3a79b2e6f49e28de293830b4865617b622c6555686f09a61abe2

# ============================================================================
# Application Configuration
# ============================================================================

# Node environment
NODE_ENV=production

# Server port
PORT=3001

# API base URL (for client requests)
VITE_API_URL=https://your-deployment.vercel.app

# ============================================================================
# Provider API Keys (Optional)
# ============================================================================

# Add your provider API keys via the dashboard instead of here
# The unified API key system prevents exposing keys in code

# Google Gemini
# GOOGLE_API_KEY=

# OpenRouter
# OPENROUTER_API_KEY=

# OpenAI compatible endpoint
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Groq
# GROQ_API_KEY=

# ============================================================================
# Monitoring & Analytics (Optional)
# ============================================================================

# Sentry error tracking
# SENTRY_DSN=

# PostHog analytics
# POSTHOG_API_KEY=

# ============================================================================
# Database Options (Development Only)
# ============================================================================

# Use SQLite for local development (optional, not recommended for production)
# DATABASE_URL=sqlite:./data/freeapi.db

# Use PostgreSQL directly (without Supabase)
# DATABASE_URL=postgresql://user:password@localhost:5432/freeapi

# ============================================================================
# Feature Flags
# ============================================================================

# Enable/disable features
ENABLE_ANALYTICS=true
ENABLE_RATE_LIMITING=true
ENABLE_DASHBOARD=true
ENABLE_VISION=true
ENABLE_STREAMING=true

# ============================================================================
# Vercel Specific (Auto-configured)
# ============================================================================

# Vercel deployment environment
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=your-deployment.vercel.app

# ============================================================================
# Notes
# ============================================================================

# To get Supabase credentials:
# 1. Go to https://app.supabase.com
# 2. Create or select a project
# 3. Go to Settings → API
# 4. Copy the URL and keys
#
# To generate ENCRYPTION_KEY:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# For Vercel deployment:
# vercel env add SUPABASE_URL <value>
# vercel env add SUPABASE_ANON_KEY <value>
# vercel env add SUPABASE_SERVICE_ROLE_KEY <value>
# vercel env add ENCRYPTION_KEY <value>
# vercel deploy --prod
