# Development Environment Template
# Copy this file to .env.local and fill in values

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3001

# CORS Configuration
DASHBOARD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173

# Rate Limiting (requests per minute, 0 = disabled for development)
PROXY_RATE_LIMIT_RPM=0

# Encryption Key
# Leave empty to use auto-generated key from database (development only)
ENCRYPTION_KEY=

# Session Secret
# Change this to a random string in production
SESSION_SECRET=dev-session-secret-change-in-production

# Supabase Configuration (Optional - development uses SQLite fallback if empty)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
